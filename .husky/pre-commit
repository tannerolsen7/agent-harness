# shellcheck shell=sh
# husky runs hooks under sh; v10 removed the shebang + auto-sourced shim. Plain POSIX sh.
# (The directive replaces the shebang as shellcheck's shell hint — without it shellcheck errors SC2148.)
set -e

STAGED=$(git diff --cached --name-only --diff-filter=ACMRDT 2>/dev/null || true)

# Agents must not commit changes to hook files — these scripts enforce the rules
# that constrain what agents can do. An agent weakening them defeats the safety floor.
if printf '%s\n' "$STAGED" | grep -qE '^\.husky/'; then
  printf 'commit blocked: hook files are protected — they enforce the safety floor.\n' >&2
  printf '  Changes to .husky/* require a direct human commit.\n' >&2
  exit 1
fi

# Sentinel direct-write guard: block staging .cr-ok or .design-confirmed directly.
# These files are gitignored and can only be staged with git add -f.
# Writing them directly bypasses scripts/cr-ok.sh and scripts/design-confirm.sh,
# which are the only scripts allowed to produce these files.
STAGED_SENTINELS=$(git diff --cached --name-only --diff-filter=ACM \
  | grep -E '^\.claude/(\.cr-ok|\.design-confirmed)$' || true)
if [ -n "$STAGED_SENTINELS" ]; then
  printf "commit blocked: sentinel files cannot be staged directly.\n" >&2
  printf "  .claude/.cr-ok       — write via scripts/cr-ok.sh\n" >&2
  printf "  .claude/.design-confirmed — write via scripts/design-confirm.sh\n" >&2
  printf "These files are gitignored and can only be staged with 'git add -f'.\n" >&2
  exit 1
fi

# GIT_DIR clearing check: every staged *.test.sh must contain the git env unset line.
# Without it, tests that create temp git repos inherit the real repo's environment
# and can corrupt the working tree or produce wrong results.
STAGED_TESTS=$(git diff --cached --name-only --diff-filter=ACM | grep '\.test\.sh$' || true)
if [ -n "$STAGED_TESTS" ]; then
  _UNSET_LINE='unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_COMMON_DIR GIT_OBJECT_DIRECTORY GIT_NAMESPACE'
  for _f in $STAGED_TESTS; do
    if ! grep -qF "$_UNSET_LINE" "$_f" 2>/dev/null; then
      printf "commit blocked: '%s' is missing the git env clear line.\n" "$_f" >&2
      printf "  Add near the top of the file:\n" >&2
      printf "  %s\n" "$_UNSET_LINE" >&2
      printf "  Without it, tests that git-init temp repos inherit the real repo's\n" >&2
      printf "  GIT_DIR and can corrupt the working tree or produce wrong results.\n" >&2
      exit 1
    fi
  done
fi

# Agent spawn lint: staged agent definitions under .claude/agents/ must have
# both Task (in tools) and permissionMode (default or auto) if they spawn sub-agents.
# Task without permissionMode fails at startup; permissionMode without Task never spawns.
STAGED_AGENTS=$(git diff --cached --name-only --diff-filter=ACM | grep '^\.claude/agents/.*\.md$' || true)
if [ -n "$STAGED_AGENTS" ]; then
  for _f in $STAGED_AGENTS; do
    _frontmatter=$(awk '/^---$/{c++; next} c==1{print} c>=2{exit}' "$_f" 2>/dev/null || true)
    _has_task=false
    _has_perm=false
    if printf '%s\n' "$_frontmatter" | grep -qE '^tools:.*\bTask\b' || \
       printf '%s\n' "$_frontmatter" | grep -qE '^\s*-\s*Task\b'; then
      _has_task=true
    fi
    if printf '%s\n' "$_frontmatter" | grep -qE '^permissionMode:\s*(default|auto)'; then
      _has_perm=true
    fi
    if $_has_task && ! $_has_perm; then
      printf "commit blocked: '%s' lists Task in tools but is missing permissionMode.\n" "$_f" >&2
      printf "  Add 'permissionMode: default' or 'permissionMode: auto' to the frontmatter.\n" >&2
      printf "  Without it, spawned sub-agents fail at startup.\n" >&2
      exit 1
    fi
    if ! $_has_task && $_has_perm; then
      printf "commit blocked: '%s' has permissionMode but is missing Task in tools.\n" "$_f" >&2
      printf "  Add 'Task' to the 'tools:' field in the frontmatter.\n" >&2
      printf "  Without Task, the agent cannot spawn sub-agents.\n" >&2
      exit 1
    fi
  done
fi

# Shell portability lint: check staged .sh files for patterns that break on BSD/macOS.
STAGED_SHELL=$(git diff --cached --name-only --diff-filter=ACM | grep '\.sh$' || true)
if [ -n "$STAGED_SHELL" ]; then
  # shellcheck disable=SC2086
  bash scripts/shell-portability-lint.sh $STAGED_SHELL
fi

bash scripts/lint.sh
# Token lint: check only the files changed in this commit for hardcoded colors/spacing
# and absolute design bans. Inert when docs/design/DESIGN.md does not exist yet.
bash scripts/token-lint.sh --diff

# Comment lint: block WHAT comments on staged shell and JS/TS files.
# Only WHY comments belong in code — comments restating what code does become
# stale noise as the code changes.
STAGED_CODE=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(sh|js|ts|jsx|tsx)$' || true)
if [ -n "$STAGED_CODE" ]; then
  # shellcheck disable=SC2086
  bash scripts/comment-lint.sh $STAGED_CODE
fi

# Data-state lint: check that every staged UI component handles all 6 states.
# A component missing any state (empty, loading, error, no-data, some-data,
# lots-of-data) will show a blank screen or crash when that state occurs.
STAGED_COMPONENTS=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(tsx|jsx)$' || true)
if [ -n "$STAGED_COMPONENTS" ]; then
  # shellcheck disable=SC2086
  bash scripts/data-state-lint.sh $STAGED_COMPONENTS
fi

# TESTING.md shard sync: when any docs/testing/*.md shard is staged, regenerate
# the local docs/TESTING.md for browsability. The file is gitignored; don't add it.
STAGED_SHARDS=$(git diff --cached --name-only --diff-filter=ACDM | grep -E "^docs/testing/[^/]+\.md$" || true)
if [ -n "$STAGED_SHARDS" ]; then
  bash scripts/assemble-testing.sh
fi

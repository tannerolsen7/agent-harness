# shellcheck shell=sh
# husky runs hooks under sh and ignores any shebang; v10 also removed the auto-sourced
# shim line. So this hook is plain POSIX sh — no shebang, no sourcing line, no bashisms.
# (The shell directive above replaces the shebang as shellcheck's hint — without it: SC2148.)
set -e

# Read all push refs from stdin upfront (git pipes these before hook logic runs).
# Format per line: <local-ref> <local-sha1> <remote-ref> <remote-sha1>
# Deletions have local-sha1 = 0000000000000000000000000000000000000000.
PUSH_INPUT=$(cat)
_ALL_DELETIONS=true
BRANCH=""
PUSH_SHA=""
# Git only calls pre-push when there are refs to push. Empty stdin means the branch is
# already up-to-date at the remote — nothing is being delivered, so nothing needs gating.
[ -z "$PUSH_INPUT" ] && exit 0
while IFS=' ' read -r _lref _lsha _rref _rsha; do
  [ -z "$_lsha" ] && continue
  if [ "$_lsha" != "0000000000000000000000000000000000000000" ]; then
    _ALL_DELETIONS=false
    # Capture branch and SHA from the first non-deletion ref so the sentinel check
    # uses the branch being pushed, not the branch HEAD currently points to.
    BRANCH=$(printf '%s' "$_lref" | sed 's|^refs/heads/||')
    PUSH_SHA="$_lsha"
    break
  fi
done <<EOF
$PUSH_INPUT
EOF
if $_ALL_DELETIONS; then
  exit 0
fi

# Fail closed if stdin parsing produced no branch (unexpected input format).
# In a real git push, BRANCH is always populated by the loop above.
if [ -z "$BRANCH" ]; then
  echo "Push blocked: could not read branch from push refs — unexpected stdin format." >&2
  exit 1
fi

# Branch naming enforcement: branches must follow type/slug naming before any network call.
# Exempt: main, master, HEAD, and empty-string (these are merge targets, not feature branches).
case "$BRANCH" in
  main|master|HEAD|"") ;;
  *)
    if ! printf '%s\n' "$BRANCH" | grep -qE '^(feat|fix|refactor|chore|docs|test|perf|build|ci|style|revert)/.+$'; then
      if printf '%s\n' "$BRANCH" | grep -qE '^(feat|fix|refactor|chore|docs|test|perf|build|ci|style|revert)/$'; then
        printf "Push blocked: '%s' is missing a slug after the slash.\n" "$BRANCH" >&2
        printf "  Rename: git branch -m %s <type>/<slug>\n" "$BRANCH" >&2
      else
        printf "Push blocked: '%s' does not follow type/slug branch naming.\n" "$BRANCH" >&2
        printf "  Rename: git branch -m %s <type>/<slug>\n" "$BRANCH" >&2
        printf "  Valid types: feat fix refactor chore docs test perf build ci style revert\n" >&2
      fi
      exit 1
    fi
    ;;
esac

# Block pushes to branches whose PR is already merged — new commits need a new branch.
if command -v gh >/dev/null 2>&1 && [ "$BRANCH" != "HEAD" ]; then
  MERGED_PR=$(gh pr list --head "$BRANCH" --state merged --json number --jq '.[0].number' 2>/dev/null || true)
  if [ -n "$MERGED_PR" ]; then
    echo "Push blocked: PR #${MERGED_PR} for branch '${BRANCH}' is already merged." >&2
    echo "Commits added after a merge need a new branch: git checkout -b <new-branch>" >&2
    exit 1
  fi
fi

# Sync gate — block push if branch is behind origin's default branch.
# Skips main/master/HEAD/"" (they're merge targets, not feature branches).
case "$BRANCH" in
  main|master|HEAD|"") ;;
  *)
    _REF=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null || true)
    _MAIN="${_REF##*/}"
    _MAIN="${_MAIN:-main}"
    if GIT_TERMINAL_PROMPT=0 timeout 15 git fetch origin "$_MAIN" --quiet 2>/dev/null; then
      _BEHIND=$(git rev-list --count "$PUSH_SHA..origin/$_MAIN" 2>/dev/null || echo 0)
      if [ "$_BEHIND" -gt 0 ]; then
        printf "Push blocked: '%s' is %s commit(s) behind origin/%s.\n" "$BRANCH" "$_BEHIND" "$_MAIN" >&2
        printf "Sync first:   git rebase origin/%s\n" "$_MAIN" >&2
        exit 1
      fi
    fi
    ;;
esac

# git pipes the push ref-list to stdin, so `[ -t 0 ]` is ALWAYS false in a pre-push hook —
# it would treat a human push like an automated one. Detect a human by whether a controlling
# terminal is reachable (/dev/tty); the agent's non-interactive Bash has none, so it takes the
# sentinel path. Fails safe: if the prompt can't be answered, the push aborts.
if { exec 3</dev/tty; } 2>/dev/null; then
  exec 3<&-
  # Interactive (human) path — TTY prompt.
  printf "\nHave you run /cr for this branch? [y/N] " > /dev/tty
  read -r confirm < /dev/tty
  if [ "$confirm" != "y" ] && [ "$confirm" != "Y" ]; then
    echo "Push aborted: run /cr before pushing (or: git push --no-verify for a deliberate manual push)." >&2
    exit 1
  fi
  # .cr-ok is validated + consumed by scripts/pr.sh at PR creation time — not checked here.
else
  # Non-interactive (agent) path — sentinel check (the un-forgeable-gate precursor).
  if [ "$BRANCH" = "HEAD" ]; then
    echo "Push blocked: repository is in detached HEAD state. Check out a branch first." >&2
    exit 1
  fi

  # Agent worktree enforcement: feature branches must be pushed from a dedicated worktree.
  # A dedicated worktree has .git as a FILE; the main worktree has .git as a DIRECTORY.
  # Exempt: main, master, HEAD, and empty-string branches.
  case "$BRANCH" in
    main|master|HEAD|"") ;;
    *)
      if [ -d .git ]; then
        _SLUG=$(printf '%s' "$BRANCH" | sed 's|.*/||')
        printf "Push blocked: '%s' must be pushed from a dedicated worktree, not the main worktree.\n" "$BRANCH" >&2
        printf "  Create one: bash scripts/worktree-add.sh .claude/worktrees/%s %s\n" "$_SLUG" "$BRANCH" >&2
        exit 1
      fi
      ;;
  esac

  SENTINEL_CR=".claude/.cr-ok"
  EXPECTED="${BRANCH}:${PUSH_SHA}"

  if [ ! -f "$SENTINEL_CR" ]; then
    echo "Push blocked: .cr-ok not found. Run /cr before pushing." >&2
    exit 1
  fi
  ACTUAL=$(cat "$SENTINEL_CR")
  if [ -z "$ACTUAL" ]; then
    echo "Push blocked: .cr-ok is empty. Re-run /cr." >&2
    exit 1
  fi
  if [ "$ACTUAL" != "$EXPECTED" ]; then
    echo "Push blocked: .cr-ok is stale (expected ${EXPECTED}, got ${ACTUAL}). Re-run /cr." >&2
    exit 1
  fi
  # .cr-ok validated — NOT consumed here; scripts/pr.sh is the sole consumer.
fi

npm test

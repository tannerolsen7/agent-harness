# dependencies
node_modules/

# husky internals (regenerated by `husky` on install)
.husky/_/

# transient sub-agent worktrees
.claude/worktrees/

# review sentinels — per-branch:sha, never committed
.claude/.cr-ok
.claude/.cr-feature-ok
.claude/*.consumed*

# machine-specific Claude Code settings (Read paths, per-machine overrides)
.claude/settings.local.json

# logs / OS cruft
*.log
.DS_Store

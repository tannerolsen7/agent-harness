# dependencies
node_modules/

# husky internals (regenerated by `husky` on install)
.husky/_/

# transient sub-agent worktrees
.claude/worktrees/

# review + design sentinels + their audit logs — per-branch:sha, never committed
.claude/.cr-ok*
.claude/.cr-feature-ok
.claude/.design-confirmed*
.claude/*.consumed*

# machine-specific Claude Code settings (Read paths, per-machine overrides)
.claude/settings.local.json

# bug-catch run outputs (transient; the corpus is committed, the results are not)
bug-catch/results/

# generated by assemble-testing.sh from shards in docs/testing/ — never committed
docs/TESTING.md

# manual checklist — generated by /feature as a one-time verification artifact, never committed
tests/manual-checklist.sh

# logs / OS cruft
*.log
.DS_Store
